---
import BaseLayout from '../layouts/BaseLayout.astro';
import { home, designProjectsMeta, socialLinks } from '../content/home';
import { proyecto } from '../content/proyecto';

const t = home.es;
const caseStudy = proyecto.es;
---

<BaseLayout title="Propuesta de inicio · Juan Pablo Armstrong" description="Exploración del inicio del portfolio de Juan Pablo Armstrong.">
  <div class="concept-page">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-mark" href="/propuesta" aria-label="Juan Pablo Armstrong, inicio de la propuesta">JPA<span>_</span></a>
        <nav aria-label="Navegación de la propuesta">
          <a href="#trabajo">Trabajo</a>
          <a href="#experiencia">Experiencia</a>
          <a href="#diseno">Diseño</a>
          <a href="/cv">CV</a>
        </nav>
        <a class="original-link" href="/" target="_blank" rel="noopener">Ver original <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Juan Pablo Armstrong, Analista Programador</p>
            <h1 id="hero-title">De la interfaz<br />a producción</h1>
            <p class="hero-lede">Combino diseño visual, desarrollo web y arquitectura AWS. Mi proyecto más completo ya funciona en una tienda real de Temuco.</p>
            <div class="hero-actions">
              <a class="action action-primary" href="/proyecto">Leer el caso DŌJŌ</a>
              <a class="action action-secondary" href={socialLinks.email}>Escribirme</a>
            </div>
            <p class="hero-footnote">AWS Certified Cloud Practitioner. Vivo en Temuco, Chile.</p>
          </div>
          <a class="hero-proof" href="/proyecto" aria-label="Ver el caso de estudio DŌJŌ">
            <div class="proof-top"><span>Un producto en producción</span></div>
            <div class="proof-center">
              <strong>DŌJŌ</strong>
              <p>Una plataforma de fidelización para Imaquinaria, tienda de manga y cultura japonesa en Temuco.</p>
            </div>
            <div class="proof-stack"><span>React 19</span><span>FastAPI</span><span>AWS</span></div>
            <div class="proof-bottom"><span>Ver cómo se construyó</span></div>
          </a>
        </div>
      </section>

      <section class="capabilities" aria-label="Áreas de trabajo">
        <div class="shell capability-grid">
          <div><strong>Diseño la experiencia</strong><small>Interfaces e identidad visual</small></div>
          <div><strong>Desarrollo el producto</strong><small>React, TypeScript, Python y FastAPI</small></div>
          <div><strong>Lo llevo a producción</strong><small>AWS, despliegue y operación</small></div>
        </div>
      </section>

      <section class="section shell work-section" id="trabajo" aria-labelledby="work-title">
        <div class="section-heading">
          <div><h2 id="work-title">Fidelización que ya funciona en tienda</h2></div>
          <p>El caso más completo de este portfolio muestra cómo conecto una necesidad de negocio con decisiones de producto y una arquitectura que ya opera en producción.</p>
        </div>
        <div class="case-layout">
          <div class="case-story">
            <p class="case-number">DŌJŌ para Imaquinaria</p>
            <h3>De compras ocasionales a una relación continua</h3>
            <p>{caseStudy.problem.need.text} Diseñé y desarrollé una plataforma para registrar compras, consultar puntos y canjear recompensas.</p>
            <div class="case-links">
              <a href="/proyecto">Leer el caso de estudio</a>
              <a href={socialLinks.platform} target="_blank" rel="noopener">Abrir la plataforma</a>
            </div>
          </div>
          <div class="case-evidence" aria-label="Alcance del proyecto">
            <div><span>Producto</span><strong>Portal de clientes + panel de administración</strong></div>
            <div><span>Arquitectura</span><strong>React, FastAPI, Lambda, DynamoDB y Cognito</strong></div>
            <div><span>Operación</span><strong>CI/CD con GitHub Actions y despliegue en AWS</strong></div>
          </div>
        </div>
      </section>

      <section class="section section-muted" id="experiencia" aria-labelledby="experience-title">
        <div class="shell">
          <div class="section-heading">
            <div><h2 id="experience-title">Una trayectoria entre diseño y tecnología</h2></div>
            <p>Mi trabajo empezó en identidad visual y medios digitales. Esa experiencia ahora informa cómo diseño interfaces, construyo sistemas y los mantengo funcionando.</p>
          </div>
          <div class="experience-list">
            {t.experience.map((item) => (
              <div class="experience-row">
                <span>{item.period}</span>
                <div><h3>{item.role}</h3><p>{item.company}</p></div>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
          <a class="text-link" href="/cv">Ver mi CV completo</a>
        </div>
      </section>

      <section class="section shell design-section" id="diseno" aria-labelledby="design-title">
        <div class="section-heading">
          <div><h2 id="design-title">La práctica visual detrás de mis interfaces</h2></div>
          <p>Antes de programar trabajé en identidad, editorial e interfaces. Estos proyectos muestran la base visual que llevo al desarrollo de productos.</p>
        </div>
        <div class="design-grid">
          {t.designProjects.map((project, index) => (
            <a href={designProjectsMeta[index].link} target="_blank" rel="noopener" class="design-card">
              <div class="design-image"><img src={designProjectsMeta[index].image} alt={project.title} loading="lazy" /></div>
              <div class="design-card-body"><span>{project.category}</span><h3>{project.title}</h3></div>
            </a>
          ))}
        </div>
        <a class="text-link" href={socialLinks.behance} target="_blank" rel="noopener">Ver todos mis proyectos visuales</a>
      </section>

      <section class="contact-section" aria-labelledby="contact-title">
        <div class="shell contact-inner">
          <div><h2 id="contact-title">Conversemos</h2></div>
          <div><p>Si mi experiencia encaja con lo que estás construyendo, puedes escribirme directamente.</p><a class="action action-primary" href={socialLinks.email}>Enviar correo</a></div>
        </div>
      </section>
    </main>

    <footer class="shell concept-footer"><span>Juan Pablo Armstrong · Temuco, Chile</span><div><a href={socialLinks.github} target="_blank" rel="noopener">GitHub</a><a href={socialLinks.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={socialLinks.behance} target="_blank" rel="noopener">Behance</a></div></footer>
  </div>
</BaseLayout>

<style>
  .concept-page{--palette-bg:#1a1b26;--palette-surface:#15161e;--palette-line:#414868;--palette-hover:#283457;--palette-text:#c0caf5;--palette-muted:#a9b1d6;--palette-blue:#7aa2f7;--palette-cyan:#7dcfff;--palette-yellow:#e0af68;--palette-grid:rgb(65 72 104 / .55);--line:var(--palette-line);--subtle:var(--palette-muted);min-height:100vh;background:var(--palette-bg);color:var(--palette-text);font-family:Manrope,sans-serif}
  .shell{width:min(100% - 48px,1200px);margin-inline:auto}
  .site-header{position:sticky;top:0;z-index:30;padding-top:var(--safe-area-top);background:rgb(26 27 38 / .94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
  .header-inner{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .header-inner nav{display:flex;align-items:center;gap:30px}.header-inner nav a,.original-link{font:500 14px 'JetBrains Mono',monospace;color:var(--subtle);text-decoration:none;transition:color 150ms ease}
  .original-link{border:1px solid var(--palette-line);padding:10px 13px;color:var(--palette-text)}.original-link span{color:var(--palette-blue);margin-left:6px}
  .hero{padding-top:26px;padding-bottom:88px;background-image:radial-gradient(var(--palette-grid) 1px,transparent 1px);background-size:24px 24px;background-position:center top}.proof-top,.proof-bottom,.case-number{font:600 14px Manrope,sans-serif}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(350px,.8fr);gap:60px;align-items:end;padding-top:70px}
  .eyebrow{font:600 14px Manrope,sans-serif;color:var(--palette-muted);margin:0 0 26px}
  h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Archivo,sans-serif}h1{font-size:clamp(52px,5.7vw,82px);letter-spacing:-.055em;line-height:1.03;font-weight:700;margin-bottom:30px}
  .hero-lede{max-width:57ch;color:var(--palette-muted);font-size:18px;line-height:1.65;margin-bottom:30px}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px}.action{min-height:48px;padding:13px 17px;display:inline-flex;align-items:center;justify-content:space-between;gap:22px;font-size:14px;font-weight:700;text-decoration:none;transition:transform 160ms var(--ease-out),background-color 160ms ease,color 160ms ease}.action:active{transform:scale(.97)}.action-primary{background:var(--palette-blue);color:var(--palette-bg)}.action-secondary{border:1px solid var(--palette-line);color:var(--palette-text)}.hero-footnote{color:var(--subtle);font:400 14px 'JetBrains Mono',monospace;margin:22px 0 0}
   .hero-proof{min-height:470px;display:flex;flex-direction:column;justify-content:space-between;padding:25px;border:1px solid var(--palette-yellow);color:var(--palette-text);background:var(--palette-surface);text-decoration:none;position:relative;transition:background-color 160ms ease}.hero-proof::before,.hero-proof::after{content:'';position:absolute;width:12px;height:12px;border:1px solid var(--palette-yellow);background:var(--palette-surface);z-index:1;pointer-events:none;transition:background-color 160ms ease}.hero-proof::before{top:-6px;left:-6px}.hero-proof::after{bottom:-6px;right:-6px}
  .proof-top,.proof-bottom{display:flex;justify-content:space-between;color:var(--palette-yellow)}.proof-center{padding:24px 0}.proof-center strong{display:block;font:700 clamp(60px,6vw,88px)/1 Archivo,sans-serif;letter-spacing:-.06em;margin:18px 0}.proof-center p{color:var(--palette-muted);font-size:15px;line-height:1.6;max-width:34ch;margin:0}.proof-stack{display:flex;flex-wrap:wrap;gap:8px}.proof-stack span{font:400 14px 'JetBrains Mono',monospace;border:1px solid var(--palette-line);padding:6px 8px;color:var(--palette-muted)}.proof-bottom{padding-top:18px;border-top:1px solid var(--palette-line);color:var(--palette-text)}
  .capabilities{border-block:1px solid var(--line);background:var(--palette-surface)}.capability-grid{display:grid;grid-template-columns:repeat(3,1fr)}.capability-grid>*{display:block;padding:27px 24px;border-right:1px solid var(--line)}.capability-grid>*:first-child{padding-left:0}.capability-grid>*:last-child{border:0}.capability-grid strong{display:block;font:600 17px Archivo,sans-serif;margin-bottom:5px}.capability-grid small{display:block;font:400 14px/1.5 Manrope,sans-serif;color:var(--subtle)}
  .section{padding-top:116px;padding-bottom:116px;scroll-margin-top:72px}.section-heading{display:grid;grid-template-columns:1fr minmax(250px,380px);gap:60px;align-items:end;margin-bottom:52px}.section-heading h2,.contact-inner h2{font-size:clamp(38px,4.3vw,62px);letter-spacing:-.045em;line-height:1.09;font-weight:700;margin:0}.section-heading>p{font-size:15px;line-height:1.7;color:var(--palette-muted);margin:0 0 4px}
  .case-layout{border-top:1px solid var(--line);display:grid;grid-template-columns:1fr .75fr}.case-story{padding:38px 58px 0 0}.case-number{color:var(--palette-yellow);margin-bottom:30px}.case-story h3{font-size:clamp(28px,3vw,42px);line-height:1.17;letter-spacing:-.035em;max-width:14ch;margin-bottom:24px}.case-story>p:not(.case-number){font-size:15px;line-height:1.75;color:var(--palette-muted);max-width:57ch}.case-links{display:flex;gap:26px;flex-wrap:wrap;margin-top:32px}.case-links a,.text-link{color:var(--palette-blue);font-size:14px;font-weight:700;text-decoration:none;border-bottom:1px solid var(--palette-blue);padding-bottom:5px}.case-evidence{border-left:1px solid var(--line)}.case-evidence div{display:grid;grid-template-columns:110px 1fr;gap:20px;padding:26px;border-bottom:1px solid var(--line)}.case-evidence div span{font:400 14px Manrope,sans-serif;color:var(--palette-yellow)}.case-evidence strong{font-size:14px;font-weight:500;line-height:1.5}
  .section-muted{background:var(--palette-surface);border-block:1px solid var(--line)}.experience-list{border-top:1px solid var(--line);margin-bottom:30px}.experience-row{display:grid;grid-template-columns:170px 1fr 1.25fr;gap:30px;padding:25px 0;border-bottom:1px solid var(--line);align-items:start}.experience-row>span{font:400 14px 'JetBrains Mono',monospace;color:var(--palette-yellow);padding-top:5px}.experience-row h3{font:600 18px/1.35 Archivo,sans-serif;margin-bottom:4px}.experience-row div p{font-size:14px;color:var(--subtle);margin:0}.experience-row>p{font-size:14px;line-height:1.6;color:var(--palette-muted);margin:0}
  .design-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:34px}.design-card{display:block;text-decoration:none;color:var(--palette-text);border:1px solid var(--line);background:var(--palette-surface);transition:border-color 160ms ease}.design-image{aspect-ratio:4/3;overflow:hidden;background:var(--palette-hover)}.design-image img{display:block;width:100%;height:100%;object-fit:cover}.design-card-body{min-height:114px;display:grid;align-content:center;padding:17px;gap:6px}.design-card-body span{font:400 14px Manrope,sans-serif;color:var(--subtle)}.design-card-body h3{font:600 17px/1.3 Archivo,sans-serif;margin:0}
  .contact-section{border-block:1px solid var(--line);background:var(--palette-hover)}.contact-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end;padding-block:84px}.contact-inner>div:last-child{justify-self:end;max-width:350px}.contact-inner>div:last-child p{color:var(--palette-muted);font-size:15px;line-height:1.6;margin-bottom:22px}.contact-inner .action{min-width:180px}
  .concept-footer{display:flex;justify-content:space-between;gap:24px;padding-block:26px;font:400 14px 'JetBrains Mono',monospace;color:var(--subtle)}.concept-footer div{display:flex;flex-wrap:wrap;gap:18px}.concept-footer a{color:var(--subtle);text-decoration:none}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:50px}.hero-proof{min-height:350px}.section-heading{grid-template-columns:1fr;gap:22px}.case-layout{grid-template-columns:1fr}.case-story{padding-right:0;padding-bottom:32px}.case-evidence{border-left:0;border-top:1px solid var(--line)}.case-evidence div{padding-inline:0}.experience-row{grid-template-columns:145px 1fr}.experience-row>p{grid-column:2}.design-grid{gap:12px}}
  @media(max-width:650px){.shell{width:auto;margin-left:max(18px,var(--safe-area-left));margin-right:max(18px,var(--safe-area-right))}.header-inner{height:auto;min-height:64px;display:grid;grid-template-columns:1fr auto;gap:0 12px;padding:12px 0}.header-inner nav{grid-column:1/-1;grid-row:2;justify-content:space-between;gap:8px;margin-top:14px}.header-inner nav a{font-size:14px}.original-link{grid-column:2;grid-row:1;font-size:14px;padding:9px}.hero{padding-top:16px;padding-bottom:60px}.hero-grid{padding-top:50px;gap:42px}.eyebrow{font-size:14px;line-height:1.5}.hero-lede{font-size:16px}.hero-proof{min-height:390px}.capability-grid{grid-template-columns:1fr}.capability-grid>*{padding:20px 0;border-right:0!important;border-bottom:1px solid var(--line)!important}.capability-grid>*:last-child{border-bottom:0!important}.section{padding-top:76px;padding-bottom:76px;scroll-margin-top:116px}.section-heading{margin-bottom:35px}.case-story{padding-top:28px}.case-evidence div{grid-template-columns:92px 1fr;gap:10px}.experience-row{grid-template-columns:1fr;gap:5px;padding:22px 0}.experience-row>p{grid-column:1}.design-grid{grid-template-columns:1fr;gap:18px}.design-image{aspect-ratio:16/9}.contact-inner{grid-template-columns:1fr;gap:26px;padding-block:65px}.contact-inner>div:last-child{justify-self:start}.concept-footer{display:block}.concept-footer div{margin-top:15px}}
  @media (hover:hover) and (pointer:fine) {
    .header-inner nav a:hover,.original-link:hover{color:var(--palette-text)}
    .action-primary:hover{background:var(--palette-cyan)}
    .action-secondary:hover{background:var(--palette-hover)}
    .hero-proof:hover,.hero-proof:hover::before,.hero-proof:hover::after{background:var(--palette-hover)}
    .case-links a:hover,.text-link:hover{color:var(--palette-text);border-color:var(--palette-text)}
    .design-card:hover{border-color:var(--palette-blue)}
    .concept-footer a:hover{color:var(--palette-text)}
  }
  @media(prefers-reduced-motion:reduce){.concept-page *{scroll-behavior:auto}.action:active{transform:none}}
</style>

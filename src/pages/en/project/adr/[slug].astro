---
import AdrTemplate from '../../../../components/AdrTemplate.astro';
import { getAdrs } from '../../../../lib/adr';

export async function getStaticPaths() {
  return (await getAdrs('en')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<AdrTemplate entry={entry} />

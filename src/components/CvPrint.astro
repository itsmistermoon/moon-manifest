---
/** CV de una columna para exportar a PDF (scripts/cv-pdf.mjs).
 *  Orden de lectura = orden visual, para que los ATS lo parseen bien. */
import { cv, contact } from '../content/cv';
import { socialLinks } from '../content/home';
import type { Locale } from '../lib/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = cv[locale];
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links = [socialLinks.platform, socialLinks.linkedin, socialLinks.github].map(strip);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{t.name} — CV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <main class="page">
      <header>
        <h1>{t.name}</h1>
        <p class="tagline">{t.tagline}</p>
        <p class="contact">
          {contact.location} · {contact.phone} · {contact.email}<br />
          {links.join(' · ')}
        </p>
      </header>

      <section>
        <h2>{t.sections.profile}</h2>
        <p>{t.profile}</p>
      </section>

      <section>
        <h2>{t.sections.experience}</h2>
        {t.experience.map((exp) => (
          <article>
            <div class="row">
              <h3>{exp.role} — {exp.company}</h3>
              <span class="meta">{exp.period}{exp.location && ` · ${exp.location}`}</span>
            </div>
            <ul>{exp.bullets.map((b) => <li>{b}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>{t.sections.skills}</h2>
        {t.skills.map((s) => (
          <p class="skill"><strong>{s.category}:</strong> {s.items.join(', ')}</p>
        ))}
      </section>

      <section>
        <h2>{t.sections.education}</h2>
        {t.education.map((edu) => (
          <article>
            <div class="row">
              <h3>{edu.title} — {edu.institution}</h3>
              <span class="meta">{edu.period}</span>
            </div>
            <p class="desc">{edu.description}</p>
          </article>
        ))}
      </section>

      <section>
        <h2>{t.sections.language}</h2>
        <p>{t.language.title}: {t.language.level}</p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Ioskeley Mono'; src: url('/fonts/IoskeleyMono-Regular.ttf') format('truetype'); font-weight: 400; }
  @page { size: A4; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', system-ui, sans-serif; font-size: 9.4pt; line-height: 1.38; color: #1a1a1a; background: #fff; }
  .page { width: 210mm; padding: 11mm 14mm; }
  h1 { font-size: 22pt; font-weight: 700; letter-spacing: -0.4px; line-height: 1.1; }
  .tagline { font-size: 11pt; font-weight: 500; color: #2f5fd0; margin-top: 2pt; }
  .contact { font-family: 'Ioskeley Mono', ui-monospace, monospace; font-size: 8.2pt; color: #555; margin-top: 5pt; }
  section { margin-top: 9pt; }
  h2 { font-size: 8.6pt; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #2f5fd0; border-bottom: 0.75pt solid #d5d9e2; padding-bottom: 2pt; margin-bottom: 6pt; }
  article { margin-bottom: 5pt; break-inside: avoid; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 8pt; }
  h3 { font-size: 10pt; font-weight: 600; }
  .meta { font-family: 'Ioskeley Mono', ui-monospace, monospace; font-size: 8.2pt; color: #666; white-space: nowrap; }
  ul { margin-top: 2pt; padding-left: 12pt; list-style: disc; }
  li { margin-bottom: 1.5pt; }
  .skill { margin-bottom: 2pt; }
  .desc { color: #444; }
</style>

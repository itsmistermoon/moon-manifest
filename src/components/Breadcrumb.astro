---
import Icon from './Icon.astro';

interface Props {
  homeHref: string;
  crumbDefault: string;
  /** Segmento intermedio opcional (e.g. las páginas ADR anidan bajo "Caso de estudio"). */
  parentCrumb?: { label: string; href: string };
  /** Solo la instancia mobile los necesita: el script del scroll-spy lee el id para
   *  encontrar el crumb y `sections` (vía data-attribute) para saber qué trackear. */
  id?: string;
  sections?: { id: string; label: string }[];
}
const { homeHref, crumbDefault, parentCrumb, id, sections } = Astro.props;
---

<span class="breadcrumb flex min-w-0 items-center text-sm font-mono">
  <a href={homeHref} aria-label="Inicio" class="brand-mark breadcrumb-root shrink-0 hover:text-accent-blue transition-colors">JPA<span>_</span></a>
  <Icon name="chevron-right" class="w-3 h-3 shrink-0 text-accent-blue mx-3" />
  {parentCrumb && (
    <>
      <a href={parentCrumb.href} class="breadcrumb-parent whitespace-nowrap text-ink-muted hover:text-ink transition-colors">{parentCrumb.label}</a>
      <span class="breadcrumb-parent-separator"><Icon name="chevron-right" class="w-3 h-3 text-accent-blue mx-3" /></span>
    </>
  )}
  <span id={id} data-sections={sections ? JSON.stringify(sections) : undefined} class="nav-crumb truncate text-ink-muted">{crumbDefault}</span>
</span>

<style>
  @media (max-width: 450px) {
    .breadcrumb-parent, .breadcrumb-parent-separator { display: none; }
  }
</style>
